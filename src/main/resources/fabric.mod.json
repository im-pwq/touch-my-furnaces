{
	"schemaVersion": 1,
	"id": "touch-my-furnaces",
	"version": "${version}",
	"name": "Touch My Furnaces",
	"description": "Load and empty furnaces with Shift + right-click — no GUI needed. Server-side, with an item blacklist/whitelist.",
	"authors": [
		"im_pwq"
	],
	"contact": {
		"homepage": "https://github.com/im_pwq/touch-my-furnaces",
		"sources": "https://github.com/im_pwq/touch-my-furnaces/tree/main"
	},
	"license": "CC0-1.0",
	"icon": "assets/touch-my-furnaces/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"pwq.tmf.TouchMyFurnaces"
		],
		"client": [
			"pwq.tmf.client.TouchMyFurnacesClient"
		],
		"modmenu": [
		"pwq.tmf.client.TmfModMenu"
		]
	},
	"mixins": [
		"touch-my-furnaces.mixins.json",
		{
			"config": "touch-my-furnaces.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"yet_another_config_lib_v3": "*"
	}
}
